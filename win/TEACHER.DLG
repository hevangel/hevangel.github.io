editteacherdlg DIALOG 11, 15, 269, 140
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Teacher"
FONT 8, "MS Sans Serif"
{
 EDITTEXT IDE_LASTNAME, 50, 6, 88, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_FIRSTNAME, 50, 20, 88, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_PASSWORD, 50, 34, 60, 12, ES_AUTOHSCROLL | ES_LOWERCASE | ES_PASSWORD | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_TEACHERCODE, 198, 5, 62, 12, ES_UPPERCASE | WS_BORDER | WS_TABSTOP
 COMBOBOX IDE_AUTHORITY, 181, 19, 79, 47, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 COMBOBOX IDE_SUBJCODE, 53, 61, 59, 67, CBS_DROPDOWN | WS_TABSTOP
 EDITTEXT IDE_SECTION, 53, 75, 26, 12
 EDITTEXT IDE_DESCRIPTION, 7, 97, 104, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 LISTBOX IDE_CLASSLIST, 174, 55, 91, 81, LBS_STANDARD | WS_TABSTOP
 PUSHBUTTON "&Add ->", IDE_ADD, 120, 66, 50, 14, WS_GROUP | WS_TABSTOP
 PUSHBUTTON "<- &Remove", IDE_REMOVE, 120, 84, 50, 14, WS_DISABLED | WS_TABSTOP
 PUSHBUTTON "&Clear", IDE_CLEAR, 120, 102, 50, 14, WS_DISABLED | WS_TABSTOP
 DEFPUSHBUTTON "OK", IDOK, 5, 121, 50, 14
 PUSHBUTTON "Cancel", IDCANCEL, 63, 121, 50, 14
 PUSHBUTTON "Help", IDHELP, 120, 120, 50, 14
 LTEXT "Last Name :", -1, 4, 8, 44, 8
 LTEXT "First Name :", -1, 4, 21, 44, 8
 LTEXT "Teacher Code :", -1, 143, 7, 54, 8
 LTEXT "Password :", -1, 8, 35, 40, 8
 CONTROL "no of class teaching :", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 164, 43, 74, 8
 CONTROL "", IDE_CLASSNO, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 243, 43, 22, 8
 LTEXT "Authority :", -1, 145, 21, 36, 8
 LTEXT "Suject Code :", -1, 7, 64, 46, 8
 LTEXT "Section No. :", -1, 7, 77, 46, 8
 GROUPBOX "Class :", ID_GROUP, 4, 50, 112, 68, BS_GROUPBOX
 LTEXT "Description :", -1, 7, 88, 46, 8
}
