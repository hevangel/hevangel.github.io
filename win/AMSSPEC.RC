#include "amsspec.h"

pdclogo BITMAP "aslogo2.bmp"

pdcbackground BITMAP "asbkgnd.bmp"

appleby BITMAP "appleby.bmp"

asicon ICON "amsspec.ico"

havicon ICON "amsview.ico"

hacicon ICON "appleby.ico"

aboutdlg DIALOG 70, 25, 140, 180
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "MS Sans Serif"
{
 ICON "asicon", -1, 14, 12, 18, 20
 CONTROL "Appleby Marking System", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 53, 9, 84, 8
 LTEXT "Spectator", -1, 53, 18, 84, 8
 LTEXT "Version 1.00", -1, 53, 27, 84, 8
 CONTROL "Program by :            Horace Chan", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 14, 42, 112, 8
 CTEXT "Special Thanks to :", -1, 12, 106, 112, 8
 CTEXT "Dr. Sampson, Mr. Thompson,", -1, 14, 115, 112, 8
 CTEXT "and Micheal Hui.", -1, 14, 124, 112, 8
 CONTROL "All Rights Reversed.", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 3, 141, 68, 8
 LTEXT "Copyright \xA9 1995", -1, 3, 149, 60, 8
 CONTROL "Power Dolls Corporation", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 3, 157, 80, 8
 DEFPUSHBUTTON "OK", IDOK, 82, 141, 50, 14
 GROUPBOX "", ID_GROUP, 6, 35, 127, 99, BS_GROUPBOX
 CONTROL "", -1, "BUTTON", BS_OWNERDRAW | WS_CHILD | WS_VISIBLE | WS_TABSTOP, -1, 166, 150, 15
 LTEXT "Alex Short", -1, 74, 51, 51, 8
}

systeminfodlg DIALOG 11, 26, 163, 157
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "System Infomaton"
FONT 8, "MS Sans Serif"
{
 DEFPUSHBUTTON "OK", IDOK, 105, 133, 50, 14
 LTEXT "Power Dolls Corporation", -1, 5, 127, 101, 8
 LTEXT "Copyright (c) 1995", -1, 6, 136, 60, 8
 LTEXT "All Rights Reserved", -1, 6, 145, 76, 8
 GROUPBOX "", ID_GROUP, 3, 3, 157, 120, BS_GROUPBOX
 LTEXT "", IDE_SYSTEMINFO, 9, 11, 144, 108
}

menu MENU
{
 POPUP "&Options"
 {
  MENUITEM "&Open Table", CM_OPEN
  MENUITEM "&Save Table", CM_SAVE
  MENUITEM "&Print", CM_PRINT
  MENUITEM "&Table Info", CM_TABLEINFO
  MENUITEM SEPARATOR
  MENUITEM "E&xit", CM_EXIT
 }

 POPUP "&Filters"
 {
  MENUITEM "&All Data", CM_ALL
  MENUITEM "All S&tudents", CM_ALLSTUDENT
  POPUP "&Grade"
  {
	MENUITEM " ", CM_GRADE
  }

  POPUP "&House"
  {
	MENUITEM " ", CM_HOUSE
  }

  POPUP "&Sex"
  {
	MENUITEM "&Male", CM_MALE
	MENUITEM "&Female", CM_FEMALE
  }
  MENUITEM "&No Students", CM_NOSTUDENT 
  MENUITEM "All S&ubjects", CM_ALLSUBJECT
  POPUP "&Faculty"
  {
	MENUITEM " ", CM_FACULTY
  }

  MENUITEM SEPARATOR
  MENUITEM "&Custom", CM_CUSTOM
 }

 POPUP "&Marks"
 {
  MENUITEM "&Previous", CM_PREV
  MENUITEM "&Next", CM_NEXT
 }

 POPUP "\a&Help"
 {
  MENUITEM "&Help", CM_HELP
  MENUITEM "&System Info", CM_SYSINFO
  MENUITEM SEPARATOR
  MENUITEM "&About", CM_ABOUT
 }

}

customdlg DIALOG 15, 22, 289, 215
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Customize Table"
FONT 8, "MS Sans Serif"
{
 DEFPUSHBUTTON "OK", IDOK, 231, 135, 50, 14
 PUSHBUTTON "Cancel", IDCANCEL, 231, 154, 50, 14
 PUSHBUTTON "Help", IDHELP, 231, 172, 50, 14
 EDITTEXT IDE_DESCRIPTION, 50, 3, 232, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 LTEXT "Description :", -1, 5, 4, 45, 8
 LISTBOX IDE_STUDENTLIST, 5, 27, 109, 86, LBS_STANDARD
 LISTBOX IDE_TABLESTUDENT, 176, 28, 108, 52, LBS_STANDARD
 LTEXT "Student List :", -1, 5, 17, 46, 8
 PUSHBUTTON "Add >", IDE_ADDSTUDENT, 120, 31, 50, 14
 PUSHBUTTON "< Remove ", IDE_REMOVESTUDENT, 120, 51, 50, 14, WS_DISABLED | WS_TABSTOP
 LTEXT "Student in table :", -1, 175, 18, 60, 8
 PUSHBUTTON "Clear", IDE_CLEARSTUDENT, 120, 72, 50, 14, WS_DISABLED | WS_TABSTOP
 COMBOBOX IDE_GROUPGRADE, 211, 80, 75, 50, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 PUSHBUTTON "Add Groups ->", IDE_ADDGROUP, 120, 92, 82, 14
 COMBOBOX IDE_GROUPHOUSE, 211, 108, 75, 55, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Grade :", -1, 181, 81, 26, 8
 LTEXT "House :", -1, 181, 109, 27, 8
 COMBOBOX IDE_ANDOR, 235, 94, 29, 33, CBS_DROPDOWNLIST | WS_TABSTOP
 LISTBOX IDE_SUBJECTLIST, 5, 122, 73, 94, LBS_STANDARD
 LTEXT "Subject List :", -1, 4, 112, 60, 8
 PUSHBUTTON "Add >", IDE_ADDSUBJECT, 84, 129, 50, 14
 PUSHBUTTON "< Remove ", IDE_REMOVESUBJECT, 84, 146, 50, 14, WS_DISABLED | WS_TABSTOP
 PUSHBUTTON "Clear", IDE_CLEARSUBJECT, 84, 163, 50, 14, WS_DISABLED | WS_TABSTOP
 PUSHBUTTON "Add Faculty", IDE_ADDFACULTY, 84, 180, 50, 14
 COMBOBOX IDE_FACULTY, 84, 197, 50, 52, CBS_DROPDOWNLIST | WS_TABSTOP
 LISTBOX IDE_TABLESUBJECT, 141, 141, 78, 69, LBS_STANDARD
 LTEXT "Subjects in table :", -1, 140, 130, 60, 8
 PUSHBUTTON "Add students of subjects", IDE_ADDSUBJSTUDENT, 84, 112, 93, 14
 RTEXT "", IDE_STUDENTNO, 266, 18, 18, 8
 RTEXT "", IDE_SUBJECTNO, 201, 131, 18, 8
}

