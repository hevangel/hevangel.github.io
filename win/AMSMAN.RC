/****************************************************************************


AMSMAN.RC

produced by Borland Resource Workshop


*****************************************************************************/

#include <amsman.h>

pdcbackground BITMAP "asbkgnd.bmp"

pdclogo BITMAP "aslogo2.bmp"

amicon ICON "amsman.ico"

hasicon ICON "amssetup.ico"

hacicon ICON "appleby.ico"

cfolder ICON "cfolder.ico"

menu MENU 
{
 POPUP "&Options"
 {
  MENUITEM "&Environment", CM_ENVIRONMENT
  MENUITEM "&Supervisor", CM_SUPERVISOR
  POPUP "&Print Data"
  {
   MENUITEM "&Teacher", CM_PRINTTEACHER
   MENUITEM "&Class", CM_PRINTCLASS
	MENUITEM "&Student", CM_PRINTSTUDENT
	MENUITEM "&Facutly", CM_PRINTFACULTY
  }

  MENUITEM SEPARATOR
  MENUITEM "&Backup data", CM_BACKUP
  MENUITEM "&Restore Data", CM_RESTORE
  MENUITEM SEPARATOR
  MENUITEM "E&xit && Save", CM_EXIT
 }

 POPUP "&Register"
 {
  MENUITEM "&Program", CM_PROGRAM
 }

 POPUP "&Window"
 {
  MENUITEM "&Tile", CM_TILE
  MENUITEM "&Cascade", CM_CASCADE
  MENUITEM "&Arrange Icon", CM_ARRANGEICON
  MENUITEM "C&lose All", CM_CLOSEALL    
 }

 POPUP "\a&Help"
 {
  MENUITEM "&Help", CM_HELP
  MENUITEM "&System Info", CM_SYSINFO
  MENUITEM SEPARATOR
  MENUITEM "&About", CM_ABOUT
 }

}

accelerator ACCELERATORS
{
 "O", IDOK, VIRTKEY, CONTROL
}


aboutdlg DIALOG 70, 25, 140, 180
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "MS Sans Serif"
{
 ICON "amicon", -1, 14, 12, 18, 20
 CONTROL "Appleby Marking System", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 53, 9, 84, 8
 LTEXT "Manager", -1, 53, 18, 84, 8
 LTEXT "Version 1.00", -1, 53, 27, 84, 8
 CONTROL "Program by :            Horace Chan", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 14, 42, 112, 8
 CTEXT "Special Thanks to :", -1, 12, 106, 112, 8
 CTEXT "Dr. Sampson, Mr. Thompson,", -1, 14, 115, 112, 8
 CTEXT "and Micheal Hui.", -1, 14, 124, 112, 8
 CONTROL "All Rights Reversed.", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 3, 141, 68, 8
 LTEXT "Copyright \xA9 1995", -1, 3, 149, 60, 8
 CONTROL "Appleby software dev.", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 3, 157, 74, 8
