 GROUPBOX "", ID_GROUP, 6, 35, 127, 99, BS_GROUPBOX
 CONTROL "", -1, "BUTTON", BS_OWNERDRAW | WS_CHILD | WS_VISIBLE | WS_TABSTOP, -1, 166, 142, 15
 LTEXT "Alex Short", -1, 75, 52, 46, 7
}

