fielddlg DIALOG 8, 17, 207, 116
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Fields Information"
FONT 8, "MS Sans Serif"
{
 EDITTEXT IDE_DESCRIPTION, 50, 15, 92, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_WEIGHT, 36, 30, 18, 12
 COMBOBOX IDE_TYPE, 80, 30, 61, 45, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 EDITTEXT IDE_RANGE, 38, 56, 96, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 PUSHBUTTON "&Calculate Now!", ID_CALCULATE, 56, 90, 62, 14, WS_TABSTOP
 LTEXT "1,3,5-12", -1, 9, 87, 32, 8, NOT WS_GROUP
 DEFPUSHBUTTON "OK", IDOK, 148, 6, 50, 14, BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP
 PUSHBUTTON "Cancel", IDCANCEL, 148, 24, 50, 14, WS_TABSTOP
 PUSHBUTTON "Help", IDHELP, 148, 42, 50, 14
 LTEXT "Field No :", -1, 4, 5, 34, 8, NOT WS_GROUP
 LTEXT "", IDE_FIELDNO, 41, 5, 60, 8
 LTEXT "Description :", -1, 4, 16, 44, 8, NOT WS_GROUP
 LTEXT "Weight :", -1, 4, 32, 30, 8, NOT WS_GROUP
 LTEXT "Type :", -1, 57, 32, 22, 8, NOT WS_GROUP
 GROUPBOX "Average :", ID_GROUP, 5, 44, 136, 64, BS_GROUPBOX
 LTEXT "Range :", -1, 9, 58, 28, 8, NOT WS_GROUP
 LTEXT "Enter field number and/or field range seperated by commas.  For example :", -1, 9, 70, 126, 18, NOT WS_GROUP
}

