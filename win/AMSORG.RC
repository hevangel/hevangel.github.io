#include "amsorg.h"



pdclogo BITMAP "aslogo2.bmp"


pdclogo2 BITMAP "aslogo3.bmp"


folder ICON "ofolder.ico"


aoicon ICON "amsorg.ico"


hacicon ICON "appleby.ico"


haeicon ICON "amsedit.ico"


menu MENU 
{
 POPUP "&Option"
 {
  MENUITEM "&Update All", CM_UPDATEALL, GRAYED
  MENUITEM SEPARATOR
  MENUITEM "&Load Class", CM_LOADCLASS, GRAYED
  MENUITEM "&Manager", CM_MANAGER, GRAYED
  MENUITEM "&Spectator", CM_SPECTATOR
  MENUITEM SEPARATOR
  MENUITEM "E&xit", CM_EXIT
 }

 POPUP "&Class"
 {
  MENUITEM "&Update Class", CM_UPDATECLASS, GRAYED
  MENUITEM "&Set Transfer", CM_TRANSFER, GRAYED
  MENUITEM "&Print", CM_PRINT, GRAYED
  MENUITEM "&Class Info", CM_CLASSINFO, GRAYED
 }

 POPUP "&Window"
 {
  MENUITEM "&Tile", CM_TILE
  MENUITEM "&Cascade", CM_CASCADE
  MENUITEM "&Arrange Icon", CM_ARRANGEICON
  MENUITEM "&Fold All", CM_FOLDALL
 }

 POPUP "\a&Help"
 {
  MENUITEM "&Help", CM_HELP
  MENUITEM "&System Info", CM_SYSINFO
  MENUITEM SEPARATOR
  MENUITEM "&About", CM_ABOUT
 }

}

logindlg DIALOG 16, 23, 155, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Login"
FONT 8, "MS Sans Serif"
{
 ICON "hacicon", -1, 14, 5, 18, 20
 LTEXT "Appleby Marking System", -1, 40, 6, 82, 8
 LTEXT "Version 1.00", -1, 41, 16, 60, 8
 LTEXT "Last Name :", -1, 12, 34, 42, 8
 LTEXT "First Name :", -1, 12, 48, 44, 8
 LTEXT "Teacher Code :", -1, 11, 62, 54, 8
 LTEXT "Password :", -1, 11, 76, 42, 8
 EDITTEXT IDE_LASTNAME, 55, 33, 88, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_FIRSTNAME, 55, 47, 88, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_TEACHERCODE, 67, 61, 44, 12, ES_AUTOHSCROLL | ES_UPPERCASE | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_PASSWORD, 50, 75, 61, 12, ES_AUTOHSCROLL | ES_LOWERCASE | ES_PASSWORD | WS_BORDER | WS_TABSTOP
