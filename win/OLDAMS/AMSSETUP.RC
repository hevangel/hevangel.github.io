 GROUPBOX "Gender :", ID_GROUP, 5, 32, 76, 26, BS_GROUPBOX
 CONTROL "Boy", IDE_BOY, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 14, 43, 26, 12
 CONTROL "Girl", IDE_GIRL, "BUTTON", BS_AUTORADIOBUTTON, 44, 43, 30, 12
