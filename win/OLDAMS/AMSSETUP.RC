#include "amssetup.h"

asicon ICON "amssetup.ico"


folder ICON "cfolder.ico"

asmenu MENU 
{
 POPUP "&Setup"
 {
  MENUITEM "&Subjects", CM_SUBJECT
  MENUITEM "&Teachers", CM_TEACHER
  MENUITEM "St&udents", CM_STUDENT
  MENUITEM "St&yle Sheet", CM_STYLE
  MENUITEM SEPARATOR
  MENUITEM "E&xit && Save", CM_EXIT
 }

 POPUP "&Options"
 {
  MENUITEM "&Options", CM_OPTION
  MENUITEM "&Data Summary", CM_SUMMARY
  MENUITEM "&Supervisor Only", CM_SUPER
  MENUITEM SEPARATOR
  MENUITEM "&Open data files", CM_OPEN
  MENUITEM "&Save data as...", CM_SAVEAS
 }

 POPUP "\a&Help"
 {
  MENUITEM "&Help", CM_HELP
  MENUITEM "&System Info", CM_SYSINFO
  MENUITEM SEPARATOR
  MENUITEM "&About", CM_ABOUT
 }

}

aclogo BITMAP "appleby1.bmp"






pdcbkgd BITMAP "pdsbkgd.bmp"

pdclogo BITMAP "pdclogo.bmp"

addclassdlg DIALOG 29, 28, 177, 60
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Add Class"
FONT 8, "MS Sans Serif"
{
 EDITTEXT IDE_SUBCODE, 5, 14, 46, 12, ES_UPPERCASE | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_SECTION, 61, 14, 16, 12, ES_UPPERCASE | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_DESCRIPTION, 6, 39, 108, 12
 LTEXT "(01-99)", -1, 81, 15, 32, 8, WS_GROUP
 DEFPUSHBUTTON "OK", IDOK, 120, 6, 50, 14, BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP
 PUSHBUTTON "Cancel", IDCANCEL, 120, 22, 50, 14, WS_TABSTOP
 PUSHBUTTON "Help", IDHELP, 120, 38, 50, 14, WS_TABSTOP
 LTEXT "Subject Code :", -1, 5, 5, 60, 8, WS_GROUP
 CONTROL "Section no :", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 61, 5, 44, 8
 LTEXT "Description :", -1, 5, 29, 60, 8, WS_GROUP
}


addteacherdlg DIALOG 10, 22, 269, 158
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Add Teacher"
FONT 8, "MS Sans Serif"
{
 EDITTEXT IDE_LASTNAME, 50, 6, 88, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_FIRSTNAME, 50, 20, 88, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_TEACHCODE, 200, 6, 48, 12, ES_UPPERCASE | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_PASSWORD, 188, 20, 60, 12, ES_LOWERCASE | ES_PASSWORD | WS_BORDER | WS_TABSTOP
 LISTBOX IDE_CLASSLISTBOX, 10, 58, 89, 85, LBS_STANDARD
 LISTBOX IDE_TEACLASSLIST, 162, 58, 97, 65, LBS_STANDARD
 CONTROL "", IDE_TOTALCLASS, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 248, 47, 16, 8
 PUSHBUTTON "&Class Info", IDE_CLASSINFO, 106, 57, 50, 14, WS_DISABLED | WS_TABSTOP
 PUSHBUTTON "&Add ->", IDE_ADDCLASS, 106, 74, 50, 14, WS_DISABLED | WS_TABSTOP
 PUSHBUTTON "<- &Remove", IDE_REMOVECLASS, 106, 91, 50, 14, WS_DISABLED | WS_TABSTOP
 PUSHBUTTON "&Clear", IDE_CLEARCLASS, 106, 108, 50, 14, WS_DISABLED | WS_TABSTOP
 DEFPUSHBUTTON "OK", IDOK, 106, 125, 50, 14
 PUSHBUTTON "Cancel", IDCANCEL, 159, 125, 50, 14
 PUSHBUTTON "Help", IDHELP, 212, 125, 50, 14
 LTEXT "Last Name :", -1, 4, 8, 44, 8
 LTEXT "First Name :", -1, 4, 21, 44, 8
 LTEXT "Teacher Code :", -1, 144, 7, 54, 8
 LTEXT "Password :", -1, 145, 21, 40, 8
 GROUPBOX "", ID_GROUP, 4, 39, 262, 108, BS_GROUPBOX
 CONTROL "no. of class available :", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 12, 46, 78, 8
 CONTROL "no. of classes teaching :", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 165, 46, 82, 8
 CONTROL "", IDE_CLASSAVA, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 90, 47, 22, 8
}


