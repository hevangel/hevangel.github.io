 CONTROL "Subjects now taking:", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE, 165, 65, 74, 8
 LTEXT "House :", -1, 195, 5, 60, 8, NOT WS_GROUP
}


