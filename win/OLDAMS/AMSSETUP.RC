 PUSHBUTTON "&Add ->", IDE_ADDCLASS, 106, 93, 50, 14, WS_DISABLED | WS_TABSTOP
 PUSHBUTTON "<- &Remove", IDE_REMOVECLASS, 106, 110, 50, 14, WS_DISABLED | WS_TABSTOP
 PUSHBUTTON "&Clear", IDE_CLEARCLASS, 106, 127, 50, 14, WS_DISABLED | WS_TABSTOP
 DEFPUSHBUTTON "OK", IDOK, 106, 144, 50, 14
 PUSHBUTTON "Cancel", IDCANCEL, 159, 144, 50, 14
 PUSHBUTTON "Help", IDHELP, 212, 144, 50, 14
 CONTROL "", IDE_SUBSTUDY, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE, 242, 66, 16, 8
 LTEXT "Last Name :", -1, 4, 4, 44, 8, NOT WS_GROUP
 LTEXT "First Name :", -1, 4, 18, 44, 8, NOT WS_GROUP
