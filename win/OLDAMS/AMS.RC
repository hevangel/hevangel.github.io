#include "ams.h"

aclogo BITMAP "appleby1.bmp"

acicon ICON "appleby.ico"

asicon ICON "amsview.ico"

amssetup ICON "amssetup.ico"

aeicon ICON "amsedit.ico"

pdclogo BITMAP "pdclogo.bmp"

pdsbkgd BITMAP "pdsbkgd.bmp"


aboutdlg DIALOG 70, 25, 140, 180
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "MS Sans Serif"
{
 ICON "acicon", -1, 14, 12, 18, 20
 CONTROL "Appleby Marking System", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 53, 9, 84, 8
 LTEXT "Main Program", -1, 53, 18, 84, 8
 LTEXT "Version 1.00a", -1, 53, 27, 84, 8
 CONTROL "Program by :            Horace Chan", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 14, 42, 112, 8
 CTEXT "This program is dedicated to :", -1, 9, 72, 122, 8
 CTEXT "Miss Sally Tang", -1, 40, 81, 60, 8, SS_CENTER | WS_DISABLED | WS_GROUP
 CTEXT "Special Thanks to :", -1, 12, 106, 112, 8
 CTEXT "Dr. Sampson, Mr. Thompson,", -1, 14, 115, 112, 8
 CTEXT "and Micheal Hui.", -1, 14, 124, 112, 8
 CONTROL "All Rights Reversed.", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 3, 141, 68, 8
 LTEXT "Copyright \xA9 1995", -1, 3, 149, 60, 8
 CONTROL "Power Dolls Corporation", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 3, 157, 80, 8
 DEFPUSHBUTTON "OK", IDOK, 82, 141, 50, 14
 GROUPBOX "", ID_GROUP, 6, 35, 127, 99, BS_GROUPBOX
 CONTROL "", -1, "BUTTON", BS_OWNERDRAW | WS_CHILD | WS_VISIBLE | WS_TABSTOP, -1, 166, 150, 15
}

cfolder ICON "cfolder.ico"

ofolder ICON "ofolder.ico"

pdclogo2 BITMAP "pdclogo2.bmp"

amsmenu MENU
{
 POPUP "&Option"
 {
  MENUITEM "&Update", CM_UPDATE
  MENUITEM "&Setup", CM_SETUP
  MENUITEM "&Viewer", CM_VIEWER
  MENUITEM "&Class Info", CM_CLASSINFO
  MENUITEM SEPARATOR
  MENUITEM "E&xit", CM_EXIT
 }

 POPUP "\a&Help"
 {
  MENUITEM "&Help", CM_HELP
  MENUITEM "&System Info", CM_SYSINFO
  MENUITEM SEPARATOR
  MENUITEM "&About", CM_ABOUT
 }

}

logindlg DIALOG 16, 21, 155, 119
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Login"
FONT 8, "MS Sans Serif"
{
 ICON "acicon", -1, 14, 5, 18, 20
 LTEXT "Appleby Marking System", -1, 40, 6, 82, 8
 LTEXT "Version 1.00a", -1, 41, 16, 60, 8
 LTEXT "Last Name :", -1, 12, 34, 42, 8
 LTEXT "First Name :", -1, 12, 48, 44, 8
 LTEXT "Password :", -1, 12, 62, 42, 8
 EDITTEXT IDE_LASTNAME, 55, 33, 88, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_FIRSTNAME, 55, 47, 88, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 EDITTEXT IDE_PASSWORD, 55, 61, 44, 12, ES_AUTOHSCROLL | ES_LOWERCASE | ES_PASSWORD | WS_BORDER | WS_TABSTOP
 DEFPUSHBUTTON "OK", IDOK, 96, 93, 50, 14
 LTEXT "Copyright  (c) 1995", -1, 4, 87, 68, 8
 LTEXT "Power Dolls Corporation", -1, 4, 97, 80, 8
 LTEXT "All Rights Reserved", -1, 4, 107, 66, 8
}

updatedlg DIALOG 6, 15, 203, 43
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Update"
FONT 8, "MS Sans Serif"
{
 LTEXT " ", IDE_UPDATE, 14, 11, 174, 12
 LTEXT "Please wait......", -1, 73, 22, 56, 8
}

