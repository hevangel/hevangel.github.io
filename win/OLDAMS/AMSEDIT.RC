 LTEXT "First midterm :", -1, 5, 17, 46, 8
 LTEXT "First term :", -1, 5, 32, 40, 8
 LTEXT "Second midterm :", -1, 5, 45, 58, 8
 LTEXT "Second term :", -1, 5, 58, 50, 8
 LTEXT "Third midterm :", -1, 5, 71, 52, 8
 LTEXT "Third term :", -1, 5, 83, 40, 8
 LTEXT "X'mas exam :", -1, 5, 96, 52, 8
 LTEXT "Final exam :", -1, 5, 109, 40, 8
 LTEXT "Final mark :", -1, 5, 123, 40, 8
 LTEXT "U. mark :", -1, 5, 137, 40, 8
 EDITTEXT IDE_FIRST_MT, 76, 16, 16, 12
 EDITTEXT IDE_FIRST_T, 76, 30, 16, 12
 EDITTEXT IDE_SECOND_MT, 76, 43, 16, 12
 EDITTEXT IDE_SECOND_T, 76, 56, 16, 12
 EDITTEXT IDE_THIRD_MT, 76, 69, 16, 12
 EDITTEXT IDE_THIRD_T, 76, 82, 16, 12
 EDITTEXT IDE_XMAS_E, 76, 95, 16, 12
 EDITTEXT IDE_FINAL_E, 76, 108, 16, 12
 EDITTEXT IDE_YEAR_M, 76, 121, 16, 12
 EDITTEXT IDE_U_M, 76, 135, 16, 12
}


inputdlg DIALOG 0, 0, 22, 13
STYLE WS_POPUP | WS_VISIBLE | WS_BORDER
FONT 8, "MS Sans Serif"
{
 EDITTEXT IDE_INPUT, 2, 2, 22, 12, NOT WS_BORDER | WS_TABSTOP
}

